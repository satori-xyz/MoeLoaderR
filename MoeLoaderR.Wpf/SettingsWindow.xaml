<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:parts="clr-namespace:MoeLoaderR.Wpf.ControlParts" x:Class="MoeLoaderR.Wpf.SettingsWindow" Title="设置 · MoeLoaderR" Width="640" Height="760" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA" Foreground="#303546" FontFamily="Microsoft YaHei" FontSize="13">
 <Window.Resources>
  <ControlTemplate x:Key="SettingsSectionTemplate" TargetType="GroupBox"><Border Background="White" BorderBrush="#E1E5EE" BorderThickness="1" CornerRadius="8" Padding="16"><DockPanel><ContentPresenter ContentSource="Header" DockPanel.Dock="Top" TextElement.FontWeight="SemiBold" TextElement.FontSize="14" Margin="0,0,0,12"/><ContentPresenter/></DockPanel></Border></ControlTemplate>
  <ControlTemplate x:Key="MoeSingleLineTextBoxControlTemplate" TargetType="TextBox"><Border x:Name="Frame" Background="White" BorderBrush="#DFE3EC" BorderThickness="1" CornerRadius="5" Padding="6,2"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#736BE4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
 </Window.Resources>
 <Grid Background="#F7F8FA"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E1E5EE" BorderThickness="0,0,0,1" Padding="24,20"><StackPanel><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="管理下载、网络与浏览偏好" Foreground="#7A8090" Margin="0,6,0,0"/></StackPanel></Border>
  <parts:SettingsControl x:Name="Options" Grid.Row="1" Margin="24,18,12,8"/>
  <Border Grid.Row="2" Background="White" BorderBrush="#E1E5EE" BorderThickness="0,1,0,0" Padding="24,14"><DockPanel><Button x:Name="DoneButton" DockPanel.Dock="Right" Content="完成" Width="88" Height="36" Background="#4F46D9" Foreground="White" IsCancel="True"/><TextBlock Text="修改即时生效，关闭时保存" Foreground="#7A8090" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>