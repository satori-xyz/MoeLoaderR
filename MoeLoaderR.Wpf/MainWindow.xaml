<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:wpf="clr-namespace:MoeLoaderR.Wpf" xmlns:controlParts="clr-namespace:MoeLoaderR.Wpf.ControlParts" x:Class="MoeLoaderR.Wpf.MainWindow" Width="{Binding MainWindowWidth, Mode=TwoWay}" Height="{Binding MainWindowHeight, Mode=TwoWay}" MinWidth="960" MinHeight="620" mc:Ignorable="d" d:DesignWidth="1045" d:DesignHeight="651.667" WindowStartupLocation="CenterScreen" Background="#F7F8FA" Foreground="#242633" FontFamily="Microsoft YaHei" FontSize="13" Icon="/MoeLoaderR;component/Assets/moeloaderr.ico">
    <Window.Resources>
        
        <Storyboard x:Key="PopupMessageShowSb">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PopupMessageBorder">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:8" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:8.4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="PopupMessageBorder">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="PopupMessageBorder">
                <EasingDoubleKeyFrame KeyTime="0" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="PopupMessageBorder">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:8" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:8.4" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        
        
    </Window.Resources>
    <Window.Title>MoeLoaderR</Window.Title>
    
    <Grid x:Name="LayoutRoot" Background="#F7F8FA"><VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DownloadPanelVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.5">
                        <VisualTransition.GeneratedEasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="HideDownloadPanelState"/>
                <VisualState x:Name="ShowDownloadPanelState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="DownloaderGrid">
                            <EasingDoubleKeyFrame KeyTime="0" Value="280"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SiteModeVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0">
                        <VisualTransition.GeneratedEasingFunction>
                            <ExponentialEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="DefaultSitesState"/>
                <VisualState x:Name="CustomSitesState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background)" Storyboard.TargetName="StatusBarBorder">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MoeCustomSitePinkBrush}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="0"/></Grid.RowDefinitions><Border Grid.RowSpan="4" Background="#F1F3F8" BorderBrush="#E3E6ED" BorderThickness="0,0,1,0" Padding="12"><DockPanel LastChildFill="False"><StackPanel x:Name="Navigation" DockPanel.Dock="Top" Margin="0,16,0,0"><Button x:Name="BrowseNavigationButton" Style="{DynamicResource ModernNavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Width="16" TextAlignment="Center"/><TextBlock Text="浏览图片" VerticalAlignment="Center"/></StackPanel></Button><CheckBox x:Name="DownloaderMenuCheckBox" FontSize="14" Margin="0,4,0,0" Style="{DynamicResource ModernNavCheckBox}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Width="16" TextAlignment="Center"/><TextBlock Text="下载管理" VerticalAlignment="Center"/></StackPanel></CheckBox></StackPanel><StackPanel x:Name="BottomNavigation" DockPanel.Dock="Bottom"><CheckBox x:Name="SettingsMenuCheckBox" FontSize="14" Style="{DynamicResource ModernNavCheckBox}" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Width="16" TextAlignment="Center"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></CheckBox><Button x:Name="LogButton" Template="{DynamicResource MoeButtonControlTemplate}" Height="34" Width="144" Content="运行日志" Margin="0,6,0,0"/></StackPanel></DockPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="#E3E6ED" BorderThickness="0,0,0,1" Padding="18,14"><controlParts:SearchControl x:Name="SearchControl" HorizontalAlignment="Stretch" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0">
                <controlParts:SearchControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </controlParts:SearchControl.RenderTransform>
            </controlParts:SearchControl></Border><Grid Grid.Column="1" Grid.Row="1" Margin="20,0"><TextBlock Text="图片浏览" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel x:Name="SizeToolbar" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="缩略图大小" Foreground="#727889" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="ImageSizeSlider" Minimum="72" Maximum="512" Value="{Binding ImageItemControlSize}" VerticalAlignment="Center" Style="{DynamicResource SimpleSlider}" Height="22" Margin="0" Width="130"/></StackPanel></Grid><Grid x:Name="ContentGrid" Grid.Row="2" Grid.Column="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="BgBorder" Margin="0" BorderBrush="#4C000000" CornerRadius="0" BorderThickness="0" Background="#F7F8FA"/>
            <controlParts:MoeExplorerControl Grid.Column="0" x:Name="MoeExplorer"/>
            <Grid x:Name="DownloaderGrid" Grid.Column="1" Width="0">
                <controlParts:DownloaderControl x:Name="MoeDownloaderControl" Width="280" AllowDrop="True"/>
            </Grid>
            
            
        </Grid><Border x:Name="PopupMessageBorder" BorderBrush="#CBD1F6" BorderThickness="1" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" Margin="120,0,120,76" CornerRadius="8" HorizontalAlignment="Center" Padding="15,10" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Grid.Column="1" Background="#EEF0FF">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            
            
            <TextBlock x:Name="PopupMessageTextBlock" TextWrapping="Wrap" Text="TextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="Black"/>
        </Border><Grid Visibility="Collapsed"><Image x:Name="LogoImage"/><Image x:Name="LogoImage2"/></Grid></Grid>
</Window>