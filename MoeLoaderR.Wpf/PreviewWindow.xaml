<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:MoeLoaderR.Wpf" x:Class="MoeLoaderR.Wpf.PreviewWindow" mc:Ignorable="d" Title="预览" Height="531.912" Width="867.089" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <ControlTemplate x:Key="PreviewPagingListBoxControlTemplate" TargetType="{x:Type ListBox}">
            <Border x:Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" TargetName="Bd" Value="White"/>
                    <Setter Property="BorderBrush" TargetName="Bd" Value="#FFD9D9D9"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsGrouping" Value="True"/>
                        <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ItemsPanelTemplate x:Key="PagingItemsPanelTemplate">
            <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="HightLightFontColorBrush" Color="#4F46D9"/>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LoadingBarVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.4">
                        <VisualTransition.GeneratedEasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="LoadingBarShowState"/>
                <VisualState x:Name="LoadingBarHideState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ImageLoadProgressBar">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Canvas x:Name="ImageCanvas" ClipToBounds="True">
            <Image x:Name="LargeImage" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScaleTransform"/>
                        <TranslateTransform x:Name="ImageTranslateTransform"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Thumb x:Name="LargeImageThumb" Height="{Binding ActualHeight, ElementName=ImageCanvas}" Width="{Binding ActualWidth, ElementName=ImageCanvas}" Background="{x:Null}" Canvas.Left="0" Canvas.Top="0">
                <Thumb.Template>
                    <ControlTemplate>
                        <Border Background="#00E000FF"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

        </Canvas>
        <ProgressBar x:Name="ImageLoadProgressBar" Width="156" Height="16" Template="{DynamicResource MoeProgressBarControlTemplate}"/>
        <Grid x:Name="ImageInfoGrid" TextBlock.Foreground="#303546">
            <Border VerticalAlignment="Top" Background="White" BorderBrush="#E1E5EE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="12">
                <StackPanel>
                    <TextBlock x:Name="InfoTitleTextBlock" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <WrapPanel x:Name="InfoWrapPanel">
                        <StackPanel Orientation="Horizontal" Margin="0,3,16,3"><TextBlock Text="作者：" Foreground="#727889"/><TextBlock x:Name="InfoUploaderTextBlock"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,16,3"><TextBlock Text="作品 ID：" Foreground="#727889"/><TextBlock x:Name="InfoIdTextBlock"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,16,3"><TextBlock Text="评分：" Foreground="#727889"/><TextBlock x:Name="InfoScoreTextBlock"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,16,3"><TextBlock Text="分辨率：" Foreground="#727889"/><TextBlock x:Name="InfoResolutionTextBlock"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><TextBlock Text="日期：" Foreground="#727889"/><TextBlock x:Name="InfoDateTextBlock"/></StackPanel>
                        <WrapPanel x:Name="PoolsWrapPanel" VerticalAlignment="Center" MaxWidth="{Binding ActualWidth, ElementName=InfoWrapPanel}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border VerticalAlignment="Bottom" Background="White" BorderBrush="#E1E5EE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="标签" Foreground="#727889" Margin="0,3,12,0"/>
                    <ScrollViewer Grid.Column="1" MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="TagsWrapPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MultiPagingGrid" Grid.Row="1" Height="0">
            <ListBox x:Name="PagingListBox" Template="{DynamicResource PreviewPagingListBoxControlTemplate}" ItemsPanel="{DynamicResource PagingItemsPanelTemplate}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="72" Height="72" Margin="4">
                            <Border x:Name="ImageBorder" Background="White" BorderBrush="#E1E5EE" BorderThickness="1" CornerRadius="6">

                            </Border>
                            <TextBlock x:Name="IndexTextBlock" TextWrapping="Wrap" Text="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </Grid>
</Window>
