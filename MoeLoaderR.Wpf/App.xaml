    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Assets/SimpleStyles.xaml"/>
                <!-- style --><ResourceDictionary Source="Assets/MoeResource.xaml" />
                <!-- lang --><ResourceDictionary Source="Assets/Lang/zh-CN.xaml" />
                <!-- lang override --><ResourceDictionary />
                <!-- style -->
                <ResourceDictionary Source="Assets/MoeStyle.xaml" />

            <ResourceDictionary Source="Assets/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
