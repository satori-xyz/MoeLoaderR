<?xml version="1.0" ?><UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sites="clr-namespace:MoeLoaderR.Core.Sites;assembly=MoeLoaderR.Core" xmlns:wpf="clr-namespace:MoeLoaderR.Wpf" xmlns:cp="clr-namespace:MoeLoaderR.Wpf.ControlParts" x:Class="MoeLoaderR.Wpf.ControlParts.SearchControl" x:Name="SearchControlRoot" MinHeight="32" mc:Ignorable="d" FontFamily="Microsoft YaHei">
    <UserControl.Resources>
        <wpf:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <wpf:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Storyboard x:Key="SearchingSpinSb" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" Storyboard.TargetName="SpinTextBlock">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="360">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="SpinTextBlock">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:1" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="SearchingState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="SearchButtonSearchIconTextBlock">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="SearchButtonTextBlock">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="SearchButtonStopIconTextBlock">
                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="SearchButtonStopTextBlock">
                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="StopingState"/>
            </VisualStateGroup>
            <VisualStateGroup x:Name="KeywordVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="SurportKeywordState"/>
                <VisualState x:Name="NotSurportKeywordState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="KeywordGrid">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsEnabled)" Storyboard.TargetName="KeywordGrid">
                            <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                        </BooleanAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SearchParaCheckBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SearchParaCheckBox" Storyboard.TargetProperty="(UIElement.Opacity)">
                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SubMenuVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ShowSubMenuState"/>
                <VisualState x:Name="HideSubMenuState">
                    <Storyboard>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="MoeSitesLv2ComboBox">
                            <EasingThicknessKeyFrame KeyTime="0" Value="0"/>
                        </ThicknessAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="MoeSitesLv2ComboBox">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="MoeSitesLv2ComboBox">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="Lv3MenuVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ShowLv3MenuState"/>
                <VisualState x:Name="HideLv3MenuState">
                    <Storyboard>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="MoeSitesLv3ComboBox">
                            <EasingThicknessKeyFrame KeyTime="0" Value="0"/>
                        </ThicknessAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="MoeSitesLv3ComboBox">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="MoeSitesLv3ComboBox">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DatePickerVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ShowDatePickerState"/>
                <VisualState x:Name="HideDatePickerState">
                    <Storyboard>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="DatePikerBorder">
                            <EasingThicknessKeyFrame KeyTime="0" Value="0"/>
                        </ThicknessAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="DatePikerBorder">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DatePikerBorder">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AccountButtonVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ShowAccountButtonState"/>
                <VisualState x:Name="HideAccountButtonState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="AccountButton">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="AccountButton">
                            <EasingThicknessKeyFrame KeyTime="0" Value="0,0,0,0"/>
                        </ThicknessAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="AccountButton">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsEnabled)" Storyboard.TargetName="AccountButton">
                            <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                        </BooleanAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="Lv4MenuVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ShowLv4MenuState"/>
                <VisualState x:Name="HideLv4MenuState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="MoeSitesLv4ComboBox">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="MoeSitesLv4ComboBox">
                            <EasingThicknessKeyFrame KeyTime="0" Value="0"/>
                        </ThicknessAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="CustomAddButtonVSG">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ShowCustomAddButtonState"/>
                <VisualState x:Name="HideCustomAddButtonState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CustomAddButton" Storyboard.TargetProperty="(FrameworkElement.Width)">
                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="CustomAddButton" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                            <EasingThicknessKeyFrame KeyTime="00:00:00" Value="0,0,0,0"/>
                        </ThicknessAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CustomAddButton" Storyboard.TargetProperty="(UIElement.Opacity)">
                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <WrapPanel x:Name="RootStackPanel" Orientation="Horizontal">
            <Button x:Name="CustomAddButton" SnapsToDevicePixels="True" Width="36" ToolTip="管理自定义站点" Opacity="1" Focusable="False" Margin="3,3" Height="36">
                <Grid Height="24" Width="24">
                    <TextBlock Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                </Grid>
            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="White" BorderBrush="#DFE3EC" BorderThickness="1" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEF0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>

            <Button x:Name="AccountButton" Tag="搜索图片" SnapsToDevicePixels="True" Width="36" ToolTip="账户登录（右键清除登录信息）" Margin="3,3" Opacity="1" Focusable="False" DataContext="{Binding ElementName=SearchControlRoot}" Height="36">
                
            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="White" BorderBrush="#DFE3EC" BorderThickness="1" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEF0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><Grid Width="22" Height="22"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#555B6D" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="AccountCheckedIconTextBlock" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#22A06B" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/></Grid></Button>
            <ComboBox x:Name="MoeSitesLv1ComboBox" Width="156" Template="{DynamicResource MoeSitesComboBoxControlTemplate}" ItemContainerStyle="{DynamicResource MoeNormalComboBoxItemStyle}" Margin="3,3" Opacity="1" Height="36">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="sites:MoeSite">
                        <Grid d:DesignWidth="175.333" d:DesignHeight="32.667">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Width="16" Height="16" Source="{Binding Icon}" Margin="2"/>
                            <TextBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock Text="" Visibility="{Binding IsUseProxy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" Grid.Column="2" Foreground="DimGray" FontFamily="{DynamicResource SystemIconFont}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Width="15" TextAlignment="Center"/>

                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="MoeSitesLv2ComboBox" Template="{DynamicResource MoeSitesComboBoxControlTemplate}" Margin="3,3" Width="144" Opacity="1" ItemContainerStyle="{DynamicResource MoeNormalComboBoxItemStyle}" ItemTemplate="{DynamicResource MoeMenuItemTemplate}" Height="36" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
            <ComboBox x:Name="MoeSitesLv3ComboBox" SelectedIndex="0" Template="{DynamicResource MoeSitesComboBoxControlTemplate}" Margin="3,3" Width="144" Opacity="1" ItemContainerStyle="{DynamicResource MoeNormalComboBoxItemStyle}" ItemTemplate="{DynamicResource MoeMenuItemTemplate}" Height="36" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
            <ComboBox x:Name="MoeSitesLv4ComboBox" SelectedIndex="0" Template="{DynamicResource MoeSitesComboBoxControlTemplate}" Margin="3,3" ItemContainerStyle="{DynamicResource MoeNormalComboBoxItemStyle}" Width="144" Opacity="1" Background="{DynamicResource MoeTextBoxBackgroundBrush}" ItemTemplate="{DynamicResource MoeMenuItemTemplate}" Height="36" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
            <Border x:Name="DatePikerBorder" Background="White" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="5" Margin="3,3" Width="128" Opacity="1" Height="36">
                <DatePicker x:Name="MoeDatePicker" VerticalAlignment="Center" BorderBrush="{x:Null}" Background="{x:Null}" Margin="4,0,0,0"/>
            </Border>
            <Grid x:Name="KeywordGridRoot" Margin="3,3" RenderTransformOrigin="0.5,0.5" Opacity="1" Height="36">

                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid x:Name="KeywordGrid" Grid.ColumnSpan="2" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{DynamicResource MoeKeywordToggleButtonControlTemplate}" Grid.ColumnSpan="2" Background="#FFDDDDDD" BorderBrush="#FF707070">
                        
                    </ToggleButton>
                    <StackPanel Grid.Column="0" x:Name="MultiWordsButtonsStackPanel" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right"/>
                    <Grid x:Name="KeywordTextGrid" Margin="4,0,4,0" Grid.Column="1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBox x:Name="KeywordTextBox" TextWrapping="NoWrap" Template="{DynamicResource MoeKeywordTextBoxControlTemplate2}" Width="240"/>
                        <TextBlock x:Name="OverflowTextBlock" TextWrapping="NoWrap" Text="搜索标签，留空浏览最新图片" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" Margin="8,0,8,0" Foreground="#727889" FontSize="12"/>
                        <TextBlock x:Name="SpinTextBlock" TextWrapping="Wrap" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource SystemIconFont}" FontSize="18" RenderTransformOrigin="0.5,0.5" Visibility="Visible" IsHitTestVisible="False" Margin="0,0,8,0" Foreground="Black">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Grid>
                <Popup d:IsOpen="True" x:Name="SearchHintParaPopup" Placement="Bottom" AllowsTransparency="True" HorizontalOffset="0" VerticalOffset="8" Focusable="True" PopupAnimation="Fade" StaysOpen="False">
                    <Grid x:Name="SearchHintParaPopupGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource MoePopupBorderStyle}">
                            <cp:SearchHintParaControl x:Name="SearchHintParaControl" Focusable="True" Margin="4"/>
                        </Border>
                    </Grid>
                </Popup>
                <CheckBox x:Name="SearchParaCheckBox" Template="{DynamicResource SearchParaCheckBoxControlTemplate}" SnapsToDevicePixels="True" Visibility="Visible" Opacity="0" Width="160">
                    <CheckBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0" ScaleY="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </CheckBox.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" d:IsLocked="True">
                        <TextBlock FontFamily="{DynamicResource SystemIconFont}" Margin="0,2,0,0"><Run Text=""/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Text="搜索参数" FontSize="14" Margin="4,0,0,0"/>
                    </StackPanel>
                </CheckBox>
            </Grid>
            <Button x:Name="SearchButton" IsDefault="True" Tag="搜索图片" Margin="3,3" Width="88" Template="{DynamicResource MoeButtonControlTemplate}" SnapsToDevicePixels="True" Height="36" Background="#4F46D9" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <Grid Height="18" Width="18">
                        <TextBlock x:Name="SearchButtonSearchIconTextBlock" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource SystemIconFont}"/>
                        <TextBlock x:Name="SearchButtonStopIconTextBlock" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                    </Grid>
                    <Grid>
                        <TextBlock x:Name="SearchButtonTextBlock" VerticalAlignment="Center" Text="搜索" FontSize="14"/>
                        <TextBlock x:Name="SearchButtonStopTextBlock" VerticalAlignment="Center" Text="停止" FontSize="14" Margin="0,0.11" Opacity="0"/>
                    </Grid>
                </StackPanel>
            </Button>

        <Button x:Name="FilterButton" Width="72" Height="36" Margin="3" ToolTip="搜索参数与筛选条件"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="筛选"/></StackPanel></Button></WrapPanel>
    </Grid>
</UserControl>