<?xml version="1.0" ?><UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:wpf="clr-namespace:MoeLoaderR.Wpf" x:Name="ItemControl" x:Class="MoeLoaderR.Wpf.ControlParts.MoeItemControl" Width="{Binding Settings.ImageItemControlSize}" Height="{Binding Settings.ImageItemControlSize}" mc:Ignorable="d" d:DesignWidth="202.044" d:DesignHeight="152.947" RenderTransformOrigin="0.5,0.5" FontFamily="Microsoft YaHei">
    <UserControl.Resources>
        <wpf:UlongToVisibilityConverter x:Key="UlongToVisibilityConverter"/>

    </UserControl.Resources>
    <UserControl.Margin>
        <MultiBinding Converter="{StaticResource OuterWidthToItemMarginConverter}" Mode="OneWay">
            <Binding ElementName="ImageItemsWrapPanel" Path="ActualWidth"/>
            <Binding ElementName="ItemControl" Path="Width"/>
        </MultiBinding>
    </UserControl.Margin>

    <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.6">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="MouseOverState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="OperationBorder">
                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        
                        
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="TitleGrid">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="LeftTopInfosStackPanel">
                            <EasingDoubleKeyFrame KeyTime="0" Value="28"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LeftOperationBorder">
                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="NormalState"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="MultiPicBgGrid" Margin="4,4,0,0" Visibility="Collapsed">
            <Border BorderThickness="1" BorderBrush="#FF666666" CornerRadius="8" Margin="4,4,0,0">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFF3F3F3" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
            </Border>
            <Border BorderThickness="1" BorderBrush="#FF666666" CornerRadius="8" Margin="0,0,4,4">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFF3F3F3" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
            </Border>
        </Grid>
        <CheckBox x:Name="ImageCheckBox" Template="{DynamicResource ImageItemCheckBoxControlTemplate}" Background="{DynamicResource MoeImageBorderBrush}">
            <Grid x:Name="ImageGrid" ClipToBounds="True" Background="#F0F1F7">
                <Border x:Name="ImageBgBorder" Opacity="0" ClipToBounds="True" Visibility="Collapsed">
                    
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="LoadFailIcon" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform><Run Text=""/></TextBlock>
                <Image x:Name="PreviewImage" Opacity="0" RenderTransformOrigin="0.5,0.5" Margin="4,4,4,28">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Grid x:Name="LoadingAnimeGrid" RenderTransformOrigin="0.5,0.5">
                    <TextBlock x:Name="LoadingIcon" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" RenderTransformOrigin="0.5,0.5">
                        
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBlock.RenderTransform><Run Text=""/></TextBlock>
                </Grid>
                <Grid Height="28" VerticalAlignment="Bottom" Background="#FCFCFE"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="LeftBottomStackPanel" HorizontalAlignment="Stretch" Orientation="Vertical" VerticalAlignment="Bottom" Margin="4,0,0,2">
                    <Border x:Name="ResolutionBorder" CornerRadius="3" Padding="1" Visibility="{Binding MoeItem.ResolutionText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="Transparent">
                        
                        <TextBlock x:Name="ResolutionTextBlock" Text="{Binding MoeItem.ResolutionText}" Margin="2" Foreground="#50576B" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding MoeItem.ResolutionText}"/>
                    </Border>
                </StackPanel><StackPanel x:Name="RightBottomInfosStackPanel" Margin="2,0,4,2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Grid.Column="1">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Border x:Name="FileTypeBorder" HorizontalAlignment="Right" Visibility="{Binding MoeItem.FileType, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" VerticalAlignment="Bottom" CornerRadius="3" Padding="1" Background="Transparent">
                        
                        <TextBlock x:Name="FileTypeTextBlock" Text="{Binding MoeItem.FileType}" Margin="2" Foreground="#50576B" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FileSizeBorder" HorizontalAlignment="Right" Visibility="{Binding MoeItem.DownloadUrlInfo.FileSize, Converter={StaticResource UlongToVisibilityConverter}, FallbackValue=Collapsed}" VerticalAlignment="Bottom" CornerRadius="3" Padding="1" Margin="2,0,0,0" Background="Transparent">
                        
                        <TextBlock x:Name="FileSizeTextBlock" Text="{Binding MoeItem.DownloadUrlInfo.FormattedFileSize}" Margin="2" Foreground="#50576B" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel></Grid>
                
                <StackPanel x:Name="LeftTopInfosStackPanel" Margin="4,4,34,0" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                        <Border x:Name="ImagesCountBorder" HorizontalAlignment="Left" Visibility="{Binding MoeItem.ChildrenItemsCount, Converter={StaticResource ImagesCountVisibilityConvertor}, Mode=OneWay}" VerticalAlignment="Top" CornerRadius="5" Margin="0,0,4,0" Padding="3,2" Background="#DC40465B">
                            
                            <TextBlock x:Name="ImagesCountTextBlock" Margin="2" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"><Run Text=" " FontFamily="{DynamicResource SystemIconFont}"/><Run Text=" "/><Run Text="{Binding MoeItem.ChildrenItemsCount, Mode=OneWay}"/></TextBlock>
                        </Border>
                        <Border x:Name="ScoreBorder" Visibility="{Binding MoeItem.Score, Converter={StaticResource DoubleToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5" Padding="3,2" Margin="0,0,4,0" Background="#DC40465B">
                            
                            <TextBlock x:Name="ScoreTextBlock" Margin="2" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"><Run Text=" " FontFamily="{DynamicResource SystemIconFont}"/><Run Text=" "/><Run Text="{Binding MoeItem.Score}"/></TextBlock>
                        </Border>
                        <Border x:Name="FavBorder" Visibility="{Binding MoeItem.FavCount, Converter={StaticResource IntToVisibilityConverter}, Mode=OneWay}" CornerRadius="5" Padding="3,2" Margin="0,0,4,0" Background="#DC40465B">
                            
                            <TextBlock x:Name="FavTextBlock" Margin="2" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"><Run Text=" " FontFamily="{DynamicResource SystemIconFont}"/><Run Text=" "/><Run Text="{Binding MoeItem.FavCount}"/></TextBlock>
                        </Border>
                    </WrapPanel>
                    <Border x:Name="TipBorder" Visibility="{Binding MoeItem.Tip, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5" Padding="1">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#A5000000" Offset="0"/>
                                <GradientStop Color="#A8404040" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="TipTextBlock" Margin="2" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding MoeItem.Tip}" FontSize="12" Foreground="{Binding MoeItem.TipHighLight, Converter={StaticResource BoolToHighLightBrush}}"/></TextBlock>
                    </Border>
                </StackPanel>
                <Grid x:Name="RankGrid" Margin="0,-40,-40,0" Visibility="{Binding MoeItem.Rank, Converter={StaticResource IntToVisibilityConverter}}" Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Ellipse HorizontalAlignment="Center" Height="96" VerticalAlignment="Center" Width="96">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#CC8FE8FF" Offset="0.599"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="RankTextBlock" TextWrapping="Wrap" Text="{Binding MoeItem.Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="-29,36,0,0"/>
                </Grid>
                <Grid x:Name="TitleGrid" Height="28" VerticalAlignment="Top" Margin="0,-30,0,0" RenderTransformOrigin="0.5,0.5" Background="#DA303546">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                                
                    <TextBlock x:Name="TitleTextBlock" TextWrapping="Wrap" Text="{Binding MoeItem.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock x:Name="IdTextBlock" TextWrapping="Wrap" Text="{Binding MoeItem.Id}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="{Binding Text, ConverterParameter=reverse, Converter={StaticResource StringToVisibilityConverter}, ElementName=TitleTextBlock}"/>
                </Grid>
            </Grid>
        </CheckBox>
        <Border x:Name="OperationBorder" VerticalAlignment="Center" HorizontalAlignment="Right" CornerRadius="6" Margin="3" Opacity="1">
            <StackPanel>
                <Button x:Name="RefreshButton" Template="{DynamicResource MoeImageOperateButtonControlTemplate}" Width="36" Height="36" Margin="1" ToolTip="Refresh">
                    <TextBlock FontFamily="{DynamicResource SystemIconFont}" Foreground="White" FontSize="16"><Run Text=""/></TextBlock>
                </Button>
                <Button x:Name="PreviewButton" Template="{DynamicResource MoeImageOperateButtonControlTemplate}" Width="36" Height="36" Margin="1" ToolTip="预览图">
                    <TextBlock FontFamily="{DynamicResource SystemIconFont}" Foreground="White" FontSize="16"><Run Text=""/></TextBlock>
                </Button>
                <Button x:Name="DetailPageLinkButton" ToolTip="{Binding MoeItem.DetailUrl}" Template="{DynamicResource MoeImageOperateButtonControlTemplate}" Width="36" Height="36" Margin="1">
                    <TextBlock FontFamily="{DynamicResource SystemIconFont}" Foreground="White" FontSize="16"><Run Text=""/></TextBlock>
                </Button>
                <Button x:Name="DownloadButton" Visibility="{Binding MoeItem.CanDownload, Converter={StaticResource BoolToVisibilityConverter}}" Template="{DynamicResource MoeImageOperateButtonControlTemplate}" Width="36" Height="36" Margin="1">
                    <Button.ToolTip>Download</Button.ToolTip>
                    <TextBlock FontFamily="{DynamicResource SystemIconFont}" Foreground="White" FontSize="16"><Run Text=""/></TextBlock>
                </Button>
            </StackPanel>
        </Border>
        <Border x:Name="LeftOperationBorder" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="6" Margin="3" Opacity="0">
            <StackPanel Visibility="{Binding MoeItem.Site.Config.IsSupportAccount, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button x:Name="ThumbButton" Template="{DynamicResource MoeImageOperateButtonControlTemplate}" Visibility="Collapsed" Width="28" Height="28" Margin="1">
                    <TextBlock FontFamily="{DynamicResource SystemIconFont}" Foreground="White"><Run Text=""/></TextBlock>
                </Button>
                <Button x:Name="StarButton" Template="{DynamicResource MoeImageOperateButtonControlTemplate}" Visibility="Collapsed" Width="28" Height="28" Margin="1">
                    <TextBlock FontFamily="{DynamicResource SystemIconFont}" Foreground="White"><Run Text=""/></TextBlock>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>