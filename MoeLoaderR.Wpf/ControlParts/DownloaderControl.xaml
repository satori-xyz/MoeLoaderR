<?xml version="1.0" ?><UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="MoeLoaderR.Wpf.ControlParts.DownloaderControl" d:DesignHeight="453.999" mc:Ignorable="d" d:DesignWidth="249.333" FontFamily="Microsoft YaHei">
    <Grid x:Name="LayoutRoot" Background="#F7F8FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border x:Name="BgBorder" BorderBrush="#E1E5EE" BorderThickness="1,0,0,0" CornerRadius="3,0,0,3" Grid.RowSpan="4"/>
        <ListBox x:Name="DownloadItemsListBox" Background="{x:Null}" BorderBrush="{x:Null}" ItemsSource="{Binding DownloadItems}" SelectionMode="Extended" ItemContainerStyle="{DynamicResource MoeDownloaderListBoxItemStyle}" ScrollViewer.CanContentScroll="True" Template="{DynamicResource MoeDownloaderItemsListBoxControlTemplate}" Grid.Row="2" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
        <Border Background="#66F5F5F5" BorderBrush="Black" BorderThickness="0" CornerRadius="0" Grid.Row="3" VerticalAlignment="Center" Margin="0,2.88" Visibility="Visible">
            <TextBlock x:Name="DownloadStatusTextBlock" HorizontalAlignment="Left" Foreground="#858B9B" Text="{Binding Items.Count, ElementName=DownloadItemsListBox, StringFormat=共 {0} 个任务}" TextWrapping="Wrap" d:LayoutOverrides="Height" Margin="4,0,0,0"/>
        </Border>
        <Popup x:Name="ContextMenuPopup" Placement="Mouse" VerticalOffset="-11" Focusable="True" StaysOpen="False" AllowsTransparency="True" Margin="0,0,0,32">
            <Grid x:Name="ContextMenuPopupGrid" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Border BorderBrush="{DynamicResource MoeButtonStrokeBrush}" Background="{DynamicResource MoeImageBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="10">
                    
                    <StackPanel Margin="4" Width="158">
                        <Button x:Name="OpenFolderButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" Text="{DynamicResource TextDownloaderContextOpenFilePath}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SelectAllButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22" d:IsLocked="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextSelectAll}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="StartButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}" Visibility="Collapsed">
                            <Grid Height="22" d:IsLocked="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextStart}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="StopButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22" d:IsLocked="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextStop}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="DeleteButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextDelete}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="RetryButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="" FontFamily="{DynamicResource SystemIconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextRetry}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="StartAllButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextStartAll}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Grid>
                                    <TextBlock TextWrapping="Wrap" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,7" FontFamily="{DynamicResource SystemIconFont}"/>
                                    <TextBlock TextWrapping="Wrap" Text="ALL" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Margin="0,12,0,0"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="StopAllButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource TextDownloaderContextStopAll}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Grid>
                                    <TextBlock TextWrapping="Wrap" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,7" FontFamily="{DynamicResource SystemIconFont}"/>
                                    <TextBlock TextWrapping="Wrap" Text="ALL" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Margin="0,12,0,0"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="DeleteAllButton" Template="{DynamicResource MoeContextMenuButtonControlTemplate}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{DynamicResource TextDownloaderContextDeleteAllComplete}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Grid>
                                    <TextBlock TextWrapping="Wrap" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,7" FontFamily="{DynamicResource SystemIconFont}"/>
                                    <TextBlock TextWrapping="Wrap" Text="ALL" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Margin="0,12,0,0"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    <DockPanel Margin="14,12"><Button x:Name="ClosePanelButton" DockPanel.Dock="Right" Content="×" Width="30" Height="30" ToolTip="收起下载管理"/><TextBlock Text="下载管理" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#303546"/></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10"><Button x:Name="StopSelectedButton" Content="停止所选" Height="30" Margin="0,0,6,0"/><Button x:Name="RetrySelectedButton" Content="重试所选" Height="30" Margin="0,0,6,0"/><Button x:Name="ClearCompletedButton" Content="清理完成" Height="30" ToolTip="移除已完成记录，保留文件"/></StackPanel><TextBlock Grid.Row="2" Text="暂无下载任务&#10;在图片上点击下载即可添加" TextAlignment="Center" Foreground="#858B9B" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=DownloadItemsListBox}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
</UserControl>